{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "suntura-dev/detect-ai",
    "type": "library",
    "description": "SDK for detecting image alteration/creation by use of AI.",
    "keywords": ["php", "open-source sdk", "sdk", "ai image detection"],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Stefan Untura",
            "email": "stefan.untura.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.10",
        "jenssegers/imagehash": "*",
        "openai-php/client": "^0.18.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "DetectAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    },
    "extra": {
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
